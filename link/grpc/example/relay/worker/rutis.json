{
  "id": "worker",
  "runtimes": {
    "go": {
      "dir": "./plugins/go"
    }
  },
  "rows": [
    {
      "id": "wire",
      "name": "go:link-grpc",
      "config": {
        "address": "127.0.0.1:7443",
        "serverName": "directory.test",
        "caFile": "/etc/rutis/grpc/ca.pem",
        "certFile": "/etc/rutis/grpc/worker.pem",
        "keyFile": "/etc/rutis/grpc/worker.key",
        "cloud": {
          "pair": "jobs",
          "target": "edge"
        }
      }
    }
  ]
}
