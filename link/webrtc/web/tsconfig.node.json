{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "ES2024"
    ],
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src/node",
    "src/shared"
  ]
}
